
pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK17'
    }

    environment {
        // Docker Hub Configuration
        DOCKER_IMAGE = 'nanducjc123/educationapprepo'

        // SonarQube Configuration
        SONAR_HOST = 'http://13.206.247.4:9000'
        SONAR_PROJECT_KEY = 'my-project'

        // AWS EKS Configuration
        AWS_REGION = 'ap-south-1'
        EKS_CLUSTER = 'java-eks-cluster'
        K8S_NAMESPACE = 'default'

        // Kubernetes Application Configuration
        APP_NAME = 'educationapp'
        APP_PORT = '8082'
        SERVICE_NAME = 'educationapp-service'
    }

    stages {

        // 1. Git Checkout
        stage('Git Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/cjcnkolhe/educationapp.git'
            }
        }

        // 2. Maven Build
        stage('Maven Build') {
            steps {
                sh '''
                    echo "Checking Java Version..."
                    java -version

                    echo "Checking Maven Version..."
                    mvn -version

                    echo "Building Spring Boot Application..."
                    mvn clean package
                '''
            }
        }

        // 3. SonarQube Analysis
        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar \
                        -Dsonar.projectKey=$SONAR_PROJECT_KEY \
                        -Dsonar.projectName=$SONAR_PROJECT_KEY \
                        -Dsonar.host.url=$SONAR_HOST \
                        -Dsonar.token=$SONAR_TOKEN \
                        -Dsonar.java.binaries=target/classes
                    '''
                }
            }
        }

        // 4. Docker Build
        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                    -t $DOCKER_IMAGE:$BUILD_NUMBER \
                    -t $DOCKER_IMAGE:latest .
                '''
            }
        }

        // 5. Docker Login & Push
        stage('Docker Login & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" \
                        --password-stdin

                        docker push $DOCKER_IMAGE:$BUILD_NUMBER
                        docker push $DOCKER_IMAGE:latest

                        docker logout
                    '''
                }
            }
        }

        // 6. Docker Pull & Run
        stage('Docker Pull & Run') {
            steps {
                sh '''
                    docker pull $DOCKER_IMAGE:$BUILD_NUMBER

                    docker stop $APP_NAME || true
                    docker rm $APP_NAME || true

                    docker run -d \
                    --name $APP_NAME \
                    --restart unless-stopped \
                    -p $APP_PORT:8080 \
                    $DOCKER_IMAGE:$BUILD_NUMBER

                    docker ps
                '''
            }
        }

        // 7. AWS EKS Connect
        stage('AWS EKS Connect') {
            steps {
                sh '''
                    export KUBECONFIG=$HOME/.kube/config

                    mkdir -p $HOME/.kube

                    aws eks update-kubeconfig \
                    --region $AWS_REGION \
                    --name $EKS_CLUSTER

                    kubectl get nodes
                '''
            }
        }

        // 8. Kubernetes Deploy
        stage('Kubernetes Deploy') {
            steps {
                sh '''
                    sed -i -E "s|image: .*|image: $DOCKER_IMAGE:$BUILD_NUMBER|" \
                    k8s/deployment.yaml

                    kubectl apply -f k8s/deployment.yaml \
                    -n $K8S_NAMESPACE

                    kubectl apply -f k8s/service.yaml \
                    -n $K8S_NAMESPACE
                '''
            }
        }

        // 9. Verification
        stage('Verification') {
            steps {
                sh '''
                    kubectl rollout status deployment/$APP_NAME \
                    -n $K8S_NAMESPACE \
                    --timeout=300s

                    kubectl get pods -n $K8S_NAMESPACE

                    kubectl get svc -n $K8S_NAMESPACE
                '''
            }
        }

        // 10. Application URL
        stage('Application URL') {
            steps {
                sh '''
                    LB_HOST=$(kubectl get svc $SERVICE_NAME \
                    -n $K8S_NAMESPACE \
                    -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')

                    if [ -n "$LB_HOST" ]; then
                        echo "Application URL: http://$LB_HOST"
                    else
                        echo "LoadBalancer is still provisioning."
                    fi
                '''
            }
        }
    }
}
